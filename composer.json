{
    "name": "tikobus/php-binlog-async",
    "description": "MySQL replication-protocol client: register as a replica over amphp/socket and stream/parse binlog events",
    "type": "library",
    "license": "MIT",
    "keywords": ["mysql", "binlog", "replication", "replica", "amphp", "async", "cdc"],
    "authors": [
        {
            "name": "tikobus"
        }
    ],
    "support": {
        "issues": "https://github.com/tikobus/php-binlog-async/issues",
        "source": "https://github.com/tikobus/php-binlog-async"
    },
    "require": {
        "php": ">=8.1",
        "amphp/socket": "^2.0",
        "ext-openssl": "*"
    },
    "require-dev": {
        "amphp/mysql": "^3.1"
    },
    "suggest": {
        "amphp/mysql": "Needed to run the examples (fetching the current binlog position via a connection pool)"
    },
    "autoload": {
        "psr-4": {
            "Tikobus\\PhpBinlogAsync\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
